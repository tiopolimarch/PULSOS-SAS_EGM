void StateMachine::InitMeters(volatile Flags &Obj_Flags) {
    // Leer datos desde memoria I2C
    HAL_I2C_Mem_Read(hi2c2, data->DIRECCION_I2C_MEM, data->Word_address,I2C_MEMADD_SIZE_16BIT, data->flash_data, 64, -1);

    // Tabla de descriptores
    struct MeterDescriptor {
        uint8_t* array;
        int*     prog;
        int*     instant;
        int      flashOffset;
    };

    MeterDescriptor meters[5] = {
        { data->Total_In_Meter_prg_A,  &data->Total_In_Meter_prg,  &data->Total_In_Meter,  5  },
        { data->Total_BET_meter_prg_A, &data->Total_BET_meter_prg, &data->Total_BET_meter, 10 },
        { data->HopperMeter_prg_A,     &data->HopperMeter_prg,     &data->HopperMeter,     15 },
        { data->Refill_prg_A,          &data->Refill_prg,          &data->Refill,          20 },
        { data->HandPayMeter_prg_A,    &data->HandPayMeter_prg,    &data->HandPayMeter,    25 }
    };

    // Inicializar arrays, valores progresivos e instantáneos
    for (auto& m : meters) {
        for (int pos = 0; pos < 5; pos++) {
            m.array[pos] = data->flash_data[pos + m.flashOffset];
        }
        *m.prog    = BCDArrayToDecimal(m.array, 5);
        *m.instant = *m.prog;
    }


    // Reset de flags si corresponde
    if (Obj_Flags.Flag_Total_In_Meter &
        Obj_Flags.Flag_Total_BET_meter &
        Obj_Flags.Flag_HopperMeter)
    {
        Obj_Flags.Flag_Botton_CashOut   = 0;
        Obj_Flags.Flag_Total_In_Meter   = 0;
        Obj_Flags.Flag_Total_BET_meter  = 0;
        Obj_Flags.Flag_HopperMeter      = 0;
    }


    done = 0;
}


