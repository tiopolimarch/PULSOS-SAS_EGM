void  StateMachine::ProcessSignal( Signal& sig, EventoTipo tipo_evt)
{
    // ========= Pulso =========
    if (*sig.flag &&
        HAL_GPIO_ReadPin(sig.gpio_port, sig.gpio_pin) == GPIO_PIN_RESET)
    {
        (*sig.counter)++;
        *sig.timer_val = __HAL_TIM_GET_COUNTER(_htim4);

        if (!(*sig.evento_activo)) {
        	 data->Contador_datos_enviados++;

        	 datosJson = CrearJsonData(tipo_evt, "str");
        	 CrearJson_obj->ConstruirJson(datosJson, data->json_progre);
        	 Envio_datos_JSON();
            *sig.evento_activo = 1;
            if (_hiwdg != nullptr)  HAL_IWDG_Refresh(_hiwdg);
        }
        *sig.flag = false;
    }

    // ========= Timeout =========
    if (*sig.evento_activo) {
        uint32_t now = __HAL_TIM_GET_COUNTER(_htim4);
        uint32_t dt = (now > *sig.timer_val) ? (now - *sig.timer_val)
                                            : (*sig.timer_val - now);

      if (dt >= sig.TimeOutMin && dt < sig.TimeOutMax) {

            *sig.valor_actual = 0;

            // Leer flash
            HAL_I2C_Mem_Read(hi2c2, data->DIRECCION_I2C_MEM,
                             data->Word_address, I2C_MEMADD_SIZE_16BIT,
                             data->flash_data, 64, -1);

            // Extraer BCD
            for (int i = 0; i < 5; i++)
                sig.contador_prg_A[i] = data->flash_data[sig.flash_offset + i];

            *sig.contador_prg = BCDArrayToDecimal(sig.contador_prg_A, 5);

            if (*sig.counter > *sig.contador_prg) {
                *sig.valor_actual = *sig.counter - *sig.contador_prg;
                *sig.contador_prg += *sig.valor_actual;
                intToBCDArray(*sig.contador_prg, sig.contador_prg_A);

                for (int i = 0; i < 5; i++)
                    data->flash_data[sig.flash_offset + i] = sig.contador_prg_A[i];
            }

            HAL_I2C_Mem_Write(hi2c2, data->DIRECCION_I2C_MEM,
                              data->Word_address, I2C_MEMADD_SIZE_16BIT,
                              data->flash_data, 64, -1);

            // JSON END
            data->Contador_datos_enviados++;
			// Preparar datos finales

			datosJson = CrearJsonData(tipo_evt, "end");

			// Enviar JSON final
			CrearJson_obj->ConstruirJson(datosJson, data->json_progre);
			Envio_datos_JSON();

            // JSON Instantáneo (BET / CASHOUT)
            if ((sig.evt == EventoTipo::Contador2 || sig.evt == EventoTipo::Contador3)
                && *sig.valor_actual > 0)
            {
            	 // Enviar JSON instantáneo
				data->Valor_Actual = *(sig.valor_actual);
				data->Contador_datos_enviados++;
				datosJson.sec = data->Contador_datos_enviados;
				CrearJson_obj->JSON_Evento_INSTANTANEO(datosJson, data->Valor_Actual, data->json_progre );
				Envio_datos_JSON();
            }

            *sig.evento_activo = 0;
        }
    }
}


void StateMachine::procesarTodasLasSignales() {
    ProcessSignal(sig1, EventoTipo::CashIn);
    ProcessSignal(sig2, EventoTipo::Bet);
    ProcessSignal(sig3, EventoTipo::CashOut);
    GeneradorPulsos::getInstance()->update();
