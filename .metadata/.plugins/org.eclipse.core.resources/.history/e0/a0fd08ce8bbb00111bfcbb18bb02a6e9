	void responderIdentidadMaquina();

	// =====================================================================
	//  EL MONTO DEL 0x1B VA EN CENTAVOS  (parche de compatibilidad)
	//
	//  El manual dice que el monto del 0x1B va en unidades de la
	//  denominacion -creditos-, y eso es lo que yo mandaba: 10.
	//
	//  Pero mi host divide ese campo entre 100 antes de mandarlo al
	//  servidor.  Comprobado en el log: cuando el 1B reporto 50, la pantalla
	//  del host imprimio "SEND HP TO SERVER: 0.5".  Por eso un pago de diez
	//  dolares aparecia en la pagina como $0,10.
	//
	//  Mi ConversorApp no tiene el problema porque el manda el monto en
	//  centavos -handpayMonto = creditos * 100- y ahi los dos /100 y *100 se
	//  cancelan.  Con esto en true la placa de pulsos hace lo mismo y queda
	//  alineada con el resto de la flota.
	//
	//  *** ESTO ES UN PARCHE, NO LA SOLUCION ***
	//  Lo correcto es que el host lea la denominacion del 0x1F -que esta
	//  placa ya declara- en vez de tener el factor clavado.  EL DIA QUE
	//  ARREGLES EL HOST, ESTO SE PONE EN false, o el monto se ira multiplicado
	//  por cien.
	//
	//  OJO: toca SOLO el campo de monto del 0x1B.  Los medidores siguen en
	//  creditos, porque el host los divide entre DENOMINACION -que trae un 5
	//  clavado- y no entre 100: mandarlos en centavos no los arregla, los
	//  empeora.  El 0x1A pasaria de 10/5=2 a 1000/5=200.
	// =====================================================================
	static const bool HANDPAY_1B_EN_CENTAVOS = true;
	static const uint32_t CENTAVOS_POR_CREDITO = 100;   // 1 credito = $1.00

	// =====================================================================
	//  AFT  -  TRANSFERENCIA ELECTRONICA DE FONDOS  (seccion 8 del SAS 6.02)
	//
	//  POR QUE ESTA ESTO AQUI.  Durante dias busque por que el cash out de
	//  la pagina no movia nada.  El tablero del 0x18 decia que ningun JSON
	//  "rcho" llegaba nunca, y el 23/09 el sniffer lo explico: mi host NO
	//  manda un JSON para el cash out remoto.  Manda AFT.
	//
	//      [COM13] 01 74 00 03 10 00 3D 46    <- pide bloqueo
	//      [COM8]  (nada)                     <- la placa no sabia contestar
	//      ...once veces, y se rindio.
	//
	//  La secuencia completa que mi host tiene programada:
	//
	//      1. 01 74 00 <cond> <timeout>   pedir bloqueo
	//         -> contesto 40 bytes con el estado en 0x40 -bloqueo pendiente-
	//         -> y encolo la excepcion 0x6F -juego bloqueado-
	//      2. 01 72 ... tipo 80 ...       "sacame todo"
	//         -> pago, contesto cuanto saque
	//         -> y encolo la excepcion 0x69 -transferencia completa-
	//      3. 01 74 80 00 00 00           desbloquear
	//         -> contesto 40 bytes con el estado en 0xFF
	//
	//  SOLO IMPLEMENTO EL RETIRO -tipo 0x80, de la maquina al host-.  Es lo
	//  unico que esta placa puede hacer de verdad: sabe cuanto credito hay y
	//  sabe pagarlo pulsando el hopper.  Una carga -tipo 0x00- se rechaza
	//  con su codigo de error, no se finge.
	//
	//  LOS MONTOS DE AFT VAN EN CENTAVOS.  Lo dicen las tablas 8.2b y 8.3a
	//  con esas palabras: "in cents".  Aqui un credito es un dolar, asi que
	//  se multiplica por cien.
	// =====================================================================
	static const bool AFT_ACTIVO = true;

	// Numero de activo de la maquina.  Mi host lo manda como 01 00 00 00 en
	// su trama de transferencia -byte bajo primero-, o sea el 1.  Si el
	// casino da de alta la placa con otro, se cambia aqui.
	static const uint32_t NUMERO_ACTIVO = 1;

	// Cuanto aguanta el bloqueo sin que el host mande la transferencia.  Si
	// se vence, la placa se desbloquea sola: un bloqueo eterno deja la
	// maquina muerta si el host se cae a la mitad.
	static const uint32_t AFT_TIMEOUT_BLOQUEO_MS = 15000;

	// Excepciones de AFT.  Las dos son PRIORITARIAS en la tabla del manual,
	// igual que el 0x51: llevan dinero detras.
	static const uint8_t SAS_EXC_JUEGO_BLOQUEADO   = 0x6F;
	static const uint8_t SAS_EXC_AFT_COMPLETA      = 0x69;

	// =====================================================================
	//  MONTO CANARIO EN EL 0x72  (sonda de escala, solo banco)
	//
	//  Con esto en true, la respuesta de la transferencia reporta SIEMPRE
	//  AFT_MONTO_CANARIO centavos, sin importar cuanto credito haya.
	//
	//  PARA QUE SIRVE.  Hoy no se si el host toma el monto del campo del
	//  0x72 o lo saca del medidor de creditos: con la maquina en 200 y una
	//  transferencia de 200, los dos caminos dan el mismo numero y no hay
	//  forma de distinguirlos.  Dejando el credito en CERO y reportando un
	//  valor inventado, si ese valor aparece en la pantalla del host solo
	//  pudo venir del 0x72.
	//
	//  POR QUE 888 Y NO 1000.  Porque 888 no se divide limpio por nada de
	//  lo que puede estar pasando, y el decimal delata el factor:
	//
	//      tal cual   -> 888        1000 -> 1000
	//      / 100      -> 8.88       1000 ->   10
	//      / 5        -> 177.6      1000 ->  200
	//      / 10       -> 88.8       1000 ->  100
	//
	//  Con 1000 todos los resultados son redondos y creibles, y uno no sabe
	//  si le dividieron o no.  Con 888 cualquier division deja decimales.
	//
	//  NO MUEVE NINGUN MEDIDOR.  Es a proposito: reportar un monto que no
	//  existe ya es bastante; si ademas moviera el 0x18 me quedaria dinero
	//  fantasma en la contabilidad.  Es una sonda de protocolo, nada mas.
	//
	//  VA EN false PARA CUALQUIER COSA QUE NO SEA ESTA PRUEBA.
	// =====================================================================
	static const bool     AFT_MONTO_CANARIO_ACTIVO = false;
	static const uint32_t AFT_MONTO_CANARIO        = 888;   // en CENTAVOS

	// =====================================================================
	//  VIGILANCIA DEL ENLACE  -  que hacer cuando el host se apaga
	//
	//  SAS es estrictamente pregunta-respuesta: el EGM nunca habla solo.
	//  Aqui hay dos cosas distintas y conviene no confundirlas.
	//
	//  1) LO QUE SIEMPRE SE HACE, este la bandera como este.  Si el host
	//     deja de polear, la placa se da cuenta y limpia lo que quedo a
	//     medias: suelta el bloqueo de AFT y tira la excepcion que estaba
	//     "en vuelo".  El manual lo pide -seccion 8.2, una maquina que
	//     entra en link down estando bloqueada tiene que soltarse- y ademas
	//     evita que al volver el host reciba el eco de una conversacion
	//     vieja.  Lo que si se conserva es la excepcion PENDIENTE: si hubo
	//     un hand pay mientras el host no estaba, se le cuenta al volver.
	//
	//  2) EL LATIDO, que es opcional y va en la bandera.  Con el enlace
	//     caido la placa manda un byte cada LATIDO_PERIODO_MS.
	//
	//  *** OJO CON EL LATIDO EN UNA MAQUINA DE VERDAD ***
	//  El bus SAS es multipunto: varios EGM colgados del mismo par.  Un EGM
	//  que transmite sin que le pregunten SE ATRAVIESA con la respuesta de
	//  otro y se la corrompe.  En el banco, con una sola placa, no pasa
	//  nada.  En una ruta con varias maquinas, esto rompe el bus de los
	//  demas.
	//
	//  Por eso va en false por defecto y por eso lo dejo escrito aqui.  Si
	//  la idea es que el host sepa que la placa sigue viva, la forma que
	//  contempla el protocolo es que el host polee y saque su conclusion
	//  del silencio, no que la maquina grite.
	// =====================================================================
	static const bool     LATIDO_ENLACE_ACTIVO = false;
	static const uint8_t  LATIDO_BYTE          = 0x01;
	static const uint32_t LATIDO_PERIODO_MS    = 1000;

	// Cuanto silencio hay que aguantar antes de dar el enlace por caido.
	//
	// Estaba en 2000 y el log del 24/09 demostro que era poco: despues de
	// una transferencia AFT el host se calla 2,501 ms procesando, y la placa
	// lo tomaba como host caido.  Ahi no paso nada porque el bloqueo ya se
	// habia soltado solo, pero con el latido encendido la placa se habria
	// puesto a hablar justo en medio de una pausa normal.
	//
	// Cinco segundos son mas de veinte poleos perdidos a su cadencia de
	// ~230 ms.  Eso ya no es una pausa: es un host que se fue.
	static const uint32_t ENLACE_TIMEOUT_MS    = 5000;


