	bool enviarTramaSas(const uint8_t* payload, uint16_t longitud);
	// Respuesta corta: direccion + comando + 4 BCD + CRC.
	//
	// Toma uint64_t, no uint32_t.  Todos los medidores tienen que salir del
	// mismo tipo: si unos caminos multiplican en 32 bits y otros en 64, el
	// MISMO medidor contesta numeros distintos segun por donde lo pregunten
	// en cuanto el acumulado crece, y uno de los dos va para atras.
	void responderContadorBCD(uint8_t comando, uint64_t valor);

	// Arma una trama de medidores de largo fijo: direccion + comando +
	// N medidores de 4 bytes BCD + CRC.  La usan el 0x0F y el 0x19, que solo
