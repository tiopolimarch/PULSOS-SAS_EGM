// ---------------------------------------------------------------------------
//  ESTADO DE LOS MEDIDORES QUE LLEVO YO
//
//  Estas cuatro variables son lo unico que la placa aporta por su cuenta a
//  la contabilidad SAS.  Todo lo demas sale de los contadores de pulsos
//  (_prg) que ya llevaba el firmware de antes.
//
//  Van a nivel de archivo y NO como miembros de la clase.  Es a proposito:
//  agregar miembros cambia el tamano de StateMachine, y si CubeIDE hace una
//  compilacion incremental donde main.cpp se queda con el tamano viejo, los
//  metodos escriben fuera del objeto y corrompen lo que haya detras.  Hay
//  una sola StateMachine en todo el proyecto, asi que a nivel de archivo
//  funciona igual y no corro ese riesgo.
//
//  LOS AJUSTES SON PROGRESIVOS: se SUMAN a lo que ya traia el contador de
//  pulsos y nunca se restan.  Un medidor SAS es un acumulado de por vida y
//  no puede ir para atras; un host que ve un medidor bajar da por perdida
//  toda la contabilidad de esa maquina.
// ---------------------------------------------------------------------------

// Lo que reporto en el 0x1A.  Este SI sube y baja: no es un acumulado, es el
// saldo que el jugador tiene en pantalla ahora mismo.
static uint32_t g_creditoActual = 0;

// Ajustes que sumo encima de los contadores de pulsos.  Los mueven los
// setters de abajo.
static uint32_t g_ajusteBillIn  = 0;   // se suma al 0x0B  (BI)
static uint32_t g_ajusteHandpay = 0;   // se suma al 0x23 y al 0x04 (HP y CC)
static uint32_t g_ajusteBet     = 0;   // se suma al 0x02  (BET)
static uint32_t g_ajusteAftOut  = 0;   // se suma al 0x18  (retiros por AFT)

// Con estos dos sigo los contadores de pulsos entre una vuelta y otra, para
// saber cuanto se movieron y aplicar esa diferencia al saldo.
static int32_t g_ultBillInPulsos = 0;
static int32_t g_ultCashOutPulsos = 0;
static bool    g_primeraLectura   = true;

// ---------------------------------------------------------------------------
//  HAND PAY PENDIENTE  (lo que contesto en el 0x1B)
//
//  El 0x1B no es un medidor: es la ficha del hand pay que esta trabado AHORA.
//  Mientras no haya ninguno la trama sale toda en ceros, que es justo lo que
//  manda la seccion 7.8.2 del SAS 6.02.
// ---------------------------------------------------------------------------
static bool     g_handpayPendiente = false;
static uint32_t g_handpayMonto     = 0;

// ---------------------------------------------------------------------------
//  COLA DE EXCEPCIONES  (solo se usa si EXCEPCIONES_SAS_ACTIVO esta en true)
//
//  "En vuelo" quiere decir: ya la transmiti pero el host todavia no me la ha
//  acusado.  Hasta que la acuse NO la puedo borrar, porque si el host repite
//  el mismo poleo general es que no la recibio y tengo que mandar la misma.
// ---------------------------------------------------------------------------
static uint8_t  g_excPendiente      = 0x00;   // la que toca mandar
static bool     g_excEnVuelo        = false;
static uint8_t  g_excEnVueloCodigo  = 0x00;

// Cuando se encolo la ultima excepcion.  De aqui cuenta la reemision del
// 0x51 que pide la seccion 7.8.1.
static uint32_t g_msUltimaExc51     = 0;

// Cuantos avisos se perdieron porque llego otro encima.  Si esto sube y
// sube, hay mas eventos que poleos y habria que pasar a una cola de verdad.
// Se mira en el debugger.
static uint32_t g_excPisadas_       = 0;

// ---------------------------------------------------------------------------
//  CONTADORES DEL DIAGNOSTICO DEL CASH OUT  (long poll 0x18)
//
//  Cuentan los cuatro eslabones de la cadena del cash out remoto.  Se topan
//  en 99 y ahi se quedan: un contador que da la vuelta me haria creer que
//  no paso nada cuando en realidad paso cien veces.
// ---------------------------------------------------------------------------
static uint8_t g_diagJsonRecibido   = 0;   // llego ALGO por el serial
static uint8_t g_diagJsonEsCashOut  = 0;   // y era un "rcho"
static uint8_t g_diagCashOutFinish  = 0;   // la FSM del hopper llego a Finish
static uint8_t g_diagSetHandpay     = 0;   // se registro en los medidores

static void diagSuma(uint8_t& contador) {
    if (contador < 99) contador++;
}

// ---------------------------------------------------------------------------
//  ESTADO DEL ENLACE CON EL HOST
//
//  Arranca CAIDO: mientras no llegue el primer poleo no hay enlace, y eso es
