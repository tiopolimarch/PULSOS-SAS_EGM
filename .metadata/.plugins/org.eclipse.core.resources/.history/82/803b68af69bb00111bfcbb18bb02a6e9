// =========================================================================
//  LA UNICA PUERTA DE ENTRADA
//
//  StateMachine.cpp llama a esto una vez por vuelta y no sabe nada mas.
//  El orden importa y por eso esta escrito:
//
//    1. service()   limpia tramas a medias si hubo ruido en la linea
//    2. atenderSas()  saca lo que llego y contesta
//    3. el saldo sigue a los pulsos fisicos
//    4. reintentos, timeouts y vigilancia del enlace
//    5. al final los modos de prueba, que son los que inventan dinero:
//       van despues de todo lo demas para que nunca le pisen un dato real
//       a la contabilidad en la misma vuelta.
// =========================================================================
bool SasEgm::servicio(bool enReposo) {
    if (!iniciado_) return false;   // nadie llamo a begin()

    rx_.service();
    atenderSas();

    actualizarCreditoPorPulsos();
    reemitirExcepcionHandpay();
    vigilarBloqueoAft();
    vigilarEnlace();

    correrModosDePrueba(enReposo);
    return correrPruebaEstres(enReposo);
}

// ---------------------------------------------------------------------------
//  LA INSTANCIA UNICA
//
//  Estatica de funcion y no global: asi se construye la primera vez que
//  alguien la pide y no antes.  En un arranque de STM32 eso importa, porque
//  el orden en que se construyen las globales entre archivos no esta definido
//  y una que dependa de otra puede encontrarsela a medio hacer.
// ---------------------------------------------------------------------------
SasEgm* SasEgm::getInstance() {
    static SasEgm unica;
    return &unica;
}

void SasEgm::begin(UART_HandleTypeDef* huartSas, VariablesGlobales* datos) {
    data_ = datos;

    // El receptor arranca aqui con nuestra direccion de bus.  A partir de
    // este momento el DMA esta armado y el SAS ya contesta poleos.
    rx_.begin(huartSas, DIRECCION_SAS);
    iniciado_ = true;
}

// Las interrupciones entran por aqui.  StateMachine las reparte y el SAS solo
// se queda con las suyas.
void SasEgm::onTxComplete()            { rx_.onTxComplete(); }
void SasEgm::onRxEvent(uint16_t size)  { rx_.onRxEvent(size); }

// =========================================================================
// FUNCIONES DE APOYO PARA SAS
// =========================================================================

uint16_t SasEgm::calcularCrc16Kermit(const uint8_t* datos, uint16_t longitud) {
	uint16_t crc = 0x0000;
	for (uint16_t i = 0; i < longitud; i++) {
		crc ^= datos[i];
		for (uint8_t bit = 0; bit < 8; bit++) {
			crc = (crc & 1) ? (crc >> 1) ^ 0x8408 : crc >> 1;
		}
	}
	return crc;
}

bool SasEgm::enviarTramaSas(const uint8_t* payload, uint16_t longitud) {
	if (longitud > 250) return false;
	return rx_.write(payload, longitud);
}

// Respuesta corta: direccion + comando + 4 bytes BCD + CRC = 8 bytes.
// Es el formato que contesta la maquina real:  01 1A 96 94 06 99 16 EE
//
// El codificador BCD es el MISMO que usa el 0x2F -bcdEncodeSas-.  Antes
// habia dos bucles distintos haciendo lo mismo en el mismo archivo; con uno
// solo, si algun dia esta mal, esta mal en un lugar y no en dos.
void SasEgm::responderContadorBCD(uint8_t comando, uint64_t valor) {
	uint8_t payload[8];
	payload[0] = DIRECCION_SAS;
	payload[1] = comando;
	bcdEncodeSas(&payload[2], valor, 4);

	uint16_t crc = calcularCrc16Kermit(payload, 6);
	payload[6] = (uint8_t)(crc & 0xFF);
	payload[7] = (uint8_t)((crc >> 8) & 0xFF);
	enviarTramaSas(payload, 8);
}

// ---------------------------------------------------------------------------
//  RESPUESTA DE VARIOS MEDIDORES EN UNA SOLA TRAMA
//
//  direccion + comando + N medidores de 4 BCD + CRC.  No lleva byte de
//  largo: el host ya sabe cuantos medidores trae cada comando, y por eso el
//  orden y la cantidad NO se pueden cambiar.
//
//    0x0F -> 6 medidores (24 bytes de datos), trama de 28
//    0x19 -> 5 medidores (20 bytes de datos), trama de 24
//
//  Si algun dia se manda un medidor de mas o de menos, el host lee todo
//  corrido y le asigna el valor equivocado a cada campo.  Eso no se ve como
//  un error en el sniffer: se ve como una maquina con numeros raros.
// ---------------------------------------------------------------------------
void SasEgm::responderBloqueMedidores(uint8_t comando,
                                            const uint64_t* valores,
                                            uint8_t nValores) {
	if (valores == nullptr) return;

	uint8_t  r[40];
	uint16_t n = 0;

	// 2 de cabecera + N x 4 + 2 de CRC tiene que caber.
	if ((uint16_t)(2 + nValores * 4 + 2) > sizeof(r)) return;

	r[n++] = DIRECCION_SAS;
	r[n++] = comando;

	for (uint8_t i = 0; i < nValores; i++) {
		bcdEncodeSas(&r[n], valores[i], 4);
		n = (uint16_t)(n + 4);
	}

	const uint16_t crc = calcularCrc16Kermit(r, n);
	r[n++] = (uint8_t)(crc & 0xFF);
	r[n++] = (uint8_t)((crc >> 8) & 0xFF);
	enviarTramaSas(r, n);
}

// ---------------------------------------------------------------------------
//  ACK DE UN BYTE
//
//  Los long polls que no devuelven datos se contestan con la propia
//  direccion.  El NACK seria esa misma direccion con el bit 7 puesto, pero
//  no lo uso: si la trama no me cuadra prefiero no contestar nada, que en
//  SAS es valido y no le promete nada al host.
// ---------------------------------------------------------------------------
void SasEgm::responderAckSimple() {
	const uint8_t ack = DIRECCION_SAS;
	enviarTramaSas(&ack, 1);
}

// ---------------------------------------------------------------------------
//  BCD: cada nibble es un digito decimal.  1234 se guarda 0x12 0x34.
//  Se recorta al maximo que cabe para que un desbordamiento no escriba
//  nibbles con valores A-F, que el host leeria como basura.
// ---------------------------------------------------------------------------
void SasEgm::bcdEncodeSas(uint8_t* destino, uint64_t valor, uint8_t nBytes) {
    // -----------------------------------------------------------------
    //  SE SATURA, NO SE DA LA VUELTA.  Esto era un bug de verdad.
    //
    //  Antes decia "valor %= 100000000ULL" con la idea de recortar lo que
    //  no cupiera.  Lo que hace un modulo es dar la vuelta, y eso en un
    //  medidor de contabilidad es lo peor que puede pasar:
    //
    //      99,999,999 creditos  ->  99 99 99 99   bien
    //     100,000,000 creditos  ->  00 00 00 00   <-- el medidor en CERO
    //     123,456,789 creditos  ->  23 45 67 89   <-- cien millones menos
    //
    //  O sea que despues de cuidar tanto que ningun medidor fuera para
    //  atras, el propio codificador lo tiraba a cero solito al desbordarse.
    //  Un host que ve eso da por perdida la contabilidad de la maquina.
    //
    //  Saturando, el medidor se queda clavado en todo nueves, que es lo que
    //  hace un contador mecanico y lo que un auditor espera ver.  Ademas
    //  quita las dos unicas divisiones de 64 bits que quedaban aqui -en un
    //  Cortex-M3 no hay division de 64 bits por hardware y cada una se iba
    //  a __aeabi_uldivmod- y el codigo sale 12 bytes mas chico.
    // -----------------------------------------------------------------
    if      (nBytes == 4) { if (valor > 99999999ULL)   valor = 99999999ULL; }
    else if (nBytes == 5) { if (valor > 9999999999ULL) valor = 9999999999ULL; }

    for (int i = nBytes - 1; i >= 0; --i) {
        uint8_t bajo = valor % 10; valor /= 10;
        uint8_t alto = valor % 10; valor /= 10;
        destino[i] = (uint8_t)((alto << 4) | bajo);
    }
}

