// ---------------------------------------------------------------------------
// Se levanta cuando el borrado de EEPROM ya corrio.  Los modos que inyectan
// dinero lo miran: pedir "borra la memoria" y "mete 200 creditos de prueba"
// al mismo tiempo son ordenes contradictorias, y de las dos gana el borrado.
static bool     g_memoriaBorrada = false;

static bool     g_enlaceArriba   = false;
static uint32_t g_msUltimaTrama  = 0;
static uint32_t g_msUltimoLatido = 0;
static uint32_t g_caidasEnlace   = 0;   // diagnostico, se mira en el debugger

// Modo mantenimiento: lo prende el long poll 0x0A y lo apaga el 0x0B.  Aqui
// no hace nada mas que quedar registrado; lo dejo para poder verlo en el
// debugger y saber si el host lo esta usando.
static bool     g_modoMantenimiento = false;


