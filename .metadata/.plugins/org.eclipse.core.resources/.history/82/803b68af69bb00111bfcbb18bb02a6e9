// --- lectura ---------------------------------------------------------------

uint32_t SasEgm::creditoActual() const { return g_creditoActual; }

// El manual prohibe bloquear para AFT si hay un hand pay esperando: seria
// pagar dos veces.  Lo consulta SasEgm_aft.cpp.
bool SasEgm::hayHandpayPendiente() const { return g_handpayPendiente; }

// --- escritura -------------------------------------------------------------

// Fija el saldo (0x1A) y registra la subida como entrada de billetero.
// Sube el 0x0B porque el credito tiene que venir de algun lado: si el 0x1A
// dice 10 y el 0x0B no se movio, el host lo ve aparecido de la nada.
void SasEgm::set_CurrentCredit(uint32_t creditos) {
    if (creditos > g_creditoActual) g_ajusteBillIn += (creditos - g_creditoActual);
    g_creditoActual = creditos;
}

// Pago a mano: sube el 0x23 y el 0x04, baja el saldo con piso en cero.
void SasEgm::set_Handpay(uint32_t creditos) {
    g_ajusteHandpay += creditos;

    if (creditos >= g_creditoActual) g_creditoActual = 0;
    else                             g_creditoActual -= creditos;

    // Cada hand pay se reporta UNA vez (7.8.1).  Si el anterior ya se leyo
    // este empieza limpio; si no, se suma.
    //
    // Lo tenia sumando SIEMPRE y sin limpiar nunca: cuatro cash outs de diez
    // reportaron 10, 20, 30 y 40 en el 0x1B y el sistema genero cuatro
    // tickets crecientes.  Salio en la prueba de estres.
    if (g_handpayPendiente) g_handpayMonto += creditos;
    else                    g_handpayMonto  = creditos;

    g_handpayPendiente = true;

    if (DIAG_CASHOUT_EN_0x18) diagSuma(g_diagSetHandpay);

    encolarExcepcionSas(SAS_EXC_HANDPAY_PENDIENTE);
}

// Apuesta -> medidor 0x00.  Progresivo, solo sube.
void SasEgm::set_Bet(uint32_t creditos) {
    g_ajusteBet += creditos;
}

// Retiro por AFT: sube el 0x18 y baja el saldo.  PRIVADO: solo lo llama el AFT.
//
// Deliberadamente NO toca el 0x04 ni el 0x23 y NO levanta hand pay pendiente.
// Un retiro electronico y un pago a mano son eventos distintos y el casino los
// tiene que poder separar.  Y si levantara hand pay, el manual prohibiria
// bloquear para el SIGUIENTE AFT: dos retiros seguidos no funcionaban.
void SasEgm::set_AftOut(uint32_t creditos) {
    g_ajusteAftOut += creditos;

    if (creditos >= g_creditoActual) g_creditoActual = 0;
    else                             g_creditoActual -= creditos;
}

// Cash out propio de la placa, ya pagado.  La bandera se mira AQUI ADENTRO:
// si los pulsos del hopper regresan por su entrada ya suben el medidor solos,
// y eso es una propiedad del cableado, no de quien llama.
void SasEgm::registrarCashOutLocal(uint32_t creditos) {
    if (!CASHOUT_REFLEJA_EN_SAS) return;
    set_Handpay(creditos);
}

// Todo a cero.
void SasEgm::reiniciarContabilidad() {
    g_ajusteBillIn  = 0;
    g_ajusteHandpay = 0;
    g_ajusteBet     = 0;
    g_ajusteAftOut  = 0;
    g_creditoActual = 0;

    // Hay que volver a tomar la referencia de los deltas, o
    // actualizarCreditoPorPulsos() intenta interpretar el salto a cero.
    g_primeraLectura = true;
    g_memoriaBorrada = true;
}

// --- diagnostico del cash out remoto (medidor 0x18) ------------------------

void SasEgm::diagJsonRecibido()   { anotarDiagCashOut(DIAG_JSON_RECIBIDO); }
void SasEgm::diagJsonEsCashOut()  { anotarDiagCashOut(DIAG_JSON_ES_CASHOUT); }
void SasEgm::diagCashOutFinish()  { anotarDiagCashOut(DIAG_CASHOUT_FINISH); }

void SasEgm::anotarDiagCashOut(uint8_t evento) {
    if (!DIAG_CASHOUT_EN_0x18) return;

    switch (evento) {
        case DIAG_JSON_RECIBIDO:   diagSuma(g_diagJsonRecibido);  break;
        case DIAG_JSON_ES_CASHOUT: diagSuma(g_diagJsonEsCashOut); break;
        case DIAG_CASHOUT_FINISH:  diagSuma(g_diagCashOutFinish); break;
        default: break;
    }
}


// ===========================================================================
//  COLA DE EXCEPCIONES
// ===========================================================================

// El 0x51, 0x52, 0x6F y 0x69 estan marcadas con P -prioritaria- en el manual,
// y por la misma razon: las cuatro llevan dinero detras.
static bool excEsPrioritaria(uint8_t codigo) {
    return codigo == 0x51 || codigo == 0x52 ||
           codigo == 0x6F || codigo == 0x69;
}

void SasEgm::encolarExcepcionSas(uint8_t codigo) {
    if (!EXCEPCIONES_SAS_ACTIVO) return;

    const bool nuevaEsPrio = excEsPrioritaria(codigo);

    // Prioridad, encontrada en el banco y no supuesta: con la prueba de estres
    // prendida la placa quedaba reenviando el 0x4F de billete -que es lo
    // correcto ante un NACK- y el 0x51 del hand pay NUNCA salia.  En 65 s:
    // 324 avisos de billete, cero de hand pay.  El aviso menos importante
    // tapaba al unico que de verdad importa.
    //
    //   - una prioritaria pisa lo que sea, pendiente o en vuelo.
    //   - una normal NO pisa a una prioritaria.
    //
    // Perder un 0x4F no cuesta: el 0x0B ya lleva el dinero y el host lo ve en
    // el siguiente 0x2F.  Perder un 0x51 si cuesta.
    if (!nuevaEsPrio) {
        if (excEsPrioritaria(g_excPendiente)) { g_excPisadas_++; return; }
        if (g_excEnVuelo && excEsPrioritaria(g_excEnVueloCodigo)) { g_excPisadas_++; return; }
    }
    else if (g_excEnVuelo && !excEsPrioritaria(g_excEnVueloCodigo)) {
        // Se abandona el reenvio de la normal: sin esto el bucle de NACK no
        // suelta nunca a la prioritaria.
        g_excEnVuelo = false;
        g_excPisadas_++;
    }

    if (g_excPendiente != 0x00 && g_excPendiente != codigo) g_excPisadas_++;

    g_excPendiente = codigo;

    // El reloj de la reemision arranca aqui, no en el arranque de la placa.
    if (codigo == SAS_EXC_HANDPAY_PENDIENTE) g_msUltimaExc51 = HAL_GetTick();
}


// ---------------------------------------------------------------------------
//  EL SALDO SIGUE A LOS PULSOS REALES
//
//  Esto corre en cada vuelta del lazo.  Mira cuanto se movieron los
//  contadores de pulsos desde la vuelta anterior y aplica esa diferencia al
//  saldo: lo que entra por billetero sube, lo que sale por cash out baja.
//
//  Trabajo por DIFERENCIAS y no restando los dos acumulados, porque esos dos
//  numeros se empezaron a contar en momentos distintos y se han borrado en
//  momentos distintos: su resta no es un saldo, no significa nada.
//
//  Un delta negativo significa que alguien borro los contadores (RAM clear).
//  En ese caso no resto nada, solo vuelvo a tomar la referencia: restarlo le
//  quitaria al jugador credito que si tenia.
// ---------------------------------------------------------------------------
void SasEgm::actualizarCreditoPorPulsos() {
    if (data_ == nullptr) return;

    const int32_t billIn  = data_->Total_In_Meter_prg;
    const int32_t cashOut = data_->HopperMeter_prg;

    if (g_primeraLectura) {
        g_ultBillInPulsos  = billIn;
        g_ultCashOutPulsos = cashOut;
        g_primeraLectura   = false;
        return;
    }

    const int32_t dIn  = billIn  - g_ultBillInPulsos;
    const int32_t dOut = cashOut - g_ultCashOutPulsos;
    g_ultBillInPulsos  = billIn;
    g_ultCashOutPulsos = cashOut;

    if (dIn < 0 || dOut < 0) return;      // hubo RAM clear, solo re-referencio

    const int32_t saldo = (int32_t)g_creditoActual + dIn - dOut;
    g_creditoActual = (saldo > 0) ? (uint32_t)saldo : 0;
}


// ---------------------------------------------------------------------------
//  DE CODIGO DE MEDIDOR SAS A VARIABLE DE LA PLACA
//
//  Esta funcion es la tabla de medidores: aqui se decide que numero contesta
//  la placa para cada codigo que pida el host.
//
//  Cada medidor sale de su contador de pulsos progresivo (_prg) mas el
//  ajuste que hayan metido los setters.  Uso los _prg y nunca los contadores
//  instantaneos, porque los instantaneos se reinician y un medidor SAS no
//  puede ir para atras.
//
//  MAPEO ACORDADO EN LA REUNION TECNICA:
//
//     0x02  BET  - apostado          <- pulso BET      + ajuste
//     0x04  CC   - creditos cancel.  <- pulso CASH OUT + ajuste hand pay
//     0x0B  BI   - billetero         <- pulso CASH IN  + ajuste
//     0x23  HP   - hand paid         <- va a la par del 0x04
//
//  El 0x23 sale del mismo numero que el 0x04 a proposito: en una maquina de
//  ruta el cash out no lo paga una tolva, lo paga una persona, asi que ese
//  mismo evento es a la vez un credito cancelado y un credito pagado a mano.
//  Como salen de la misma fuente, no se pueden desfasar.
//
//  Los medidores que esta placa no tiene de donde sacar se contestan en CERO
//  y no se omiten: una maquina de ruta sin contador de jackpots tiene, de
//  verdad, cero jackpots, y asi el host la ve completa.
//
//  Devuelve true si el medidor tiene una fuente real detras.  El que
//  devuelve false igual se contesta, pero en cero.
// ---------------------------------------------------------------------------
bool SasEgm::obtenerValorMedidorRuta(uint8_t codigo, uint64_t* salida) {
    if (salida == nullptr) return false;
    *salida = 0;
    if (data_ == nullptr) return false;

    const uint64_t k = (uint64_t)SAS_CREDITOS_POR_PULSO;

    switch (codigo) {
        // ------------------------------------------------------------------
        // 0x00 Total coin in credits.  ESTE ES EL BET.
        //
        // En SAS no existe un medidor que se llame "bet": lo apostado se
        // reporta como "coin in", que es el nombre que quedo de cuando las
        // maquinas tragaban monedas.  Tabla C-7 del manual 6.02.
        //
        // OJO: antes aqui tambien caia el 0x02, porque asi venia en el
        // pizarron.  Estaba mal.  Segun la tabla C-7 el 0x02 es "Total
        // jackpot credits" y no tiene nada que ver con la apuesta.  Mandar
        // el BET ahi le inventaba premios a la maquina, y como el 0x22
        // -total ganado- y el 0x23 -total pagado a mano- se definen SUMANDO
        // el jackpot, el error se propagaba a esos dos tambien.
        // ------------------------------------------------------------------
        case 0x00:
            *salida = ((uint64_t)data_->Total_BET_meter_prg + g_ajusteBet) * k;
            return true;

        // 0x0C Current credits.  Es el mismo saldo que contesto en el long
        // poll 0x1A.  Lo pongo aqui para que un host que lo pida por 0x2F -en
        // vez de por 0x1A- reciba el numero de verdad y no un cero.
        case 0x0C:
            *salida = (uint64_t)g_creditoActual * k;
            return true;

        // 0x0B credits from bill accepted.  El cash in de esta placa entra
        // por billetero.
        case 0x0B:
            *salida = ((uint64_t)data_->Total_In_Meter_prg + g_ajusteBillIn) * k;
            return true;

        // 0x04 Total cancelled credits y 0x23 Total hand paid credits.
        //
        // Los dos contestan el mismo numero porque asi lo pedi: lo que sale
        // por el CC-04 se tiene que ver a la par en el 23.
        //
        // PENDIENTE DE REVISAR CON EL MANUAL.  La tabla C-7 define el 0x23
        // como "hand paid cancelled credits + jackpot", o sea 0x03 + 0x02, y
        // no como una copia del 0x04.  Con el jackpot en cero, el 0x23
        // deberia seguir al 0x03 -el pulso de HAND PAY- y no al hopper.
        // Lo dejo como esta porque asi lo acordamos y asi lo estamos
        // probando, pero antes de campo hay que decidirlo.
        case 0x04:
        case 0x23:
            *salida = ((uint64_t)data_->HopperMeter_prg + g_ajusteHandpay) * k;
            return true;

        // ------------------------------------------------------------------
        //  0x18 — NORMALMENTE CERO, PERO AQUI VA EL DIAGNOSTICO DEL CASH OUT
        //
        //  El medidor 0x18 de la tabla C-7 es "transferencias electronicas
        //  al host", o sea AFT.  Esta placa no hace AFT, asi que siempre
        //  contesta cero y NADA depende de el.
        //
        //  Por eso lo uso de tablero: mi ronda del POG ya pide el 0x18 en su
        //  0x2F, asi que el diagnostico del cash out remoto aparece solo en
        //  el log que ya estoy capturando, sin tocar el host, sin recompilar
        //  el POG y sin agregar un paso a la ronda.
        //
        //  Se lee como cuatro numeros de dos digitos, NO como una cantidad:
        //
        //      18 <AA> <BB> <CC> <DD>
        //         │     │     │     └─ set_Handpay se llamo
        //         │     │     └─────── el CashOut llego a Finish
        //         │     └───────────── el JSON traia "rcho"
        //         └─────────────────── llego algo por el serial
        //
        //  Con DIAG_CASHOUT_EN_0x18 en false vuelve a ser cero, que es lo
        //  que tiene que contestar en campo.
        // ------------------------------------------------------------------
        // 0x18 Total electronic transfers to host: los retiros por AFT.
        // Ahora SI tiene fuente real, porque la placa ya hace AFT.  Es la
        // casilla que mi host pinta como AFT_OUT.
        case 0x18:
            if (!DIAG_CASHOUT_EN_0x18) {
                *salida = (uint64_t)g_ajusteAftOut * k;
                return true;
            }
            if (DIAG_CASHOUT_EN_0x18) {
                // Se arma en DECIMAL para que el codificador BCD deje cada
                // contador en su propio byte: 01 02 03 04 -> 1020304.
                *salida = (uint64_t)g_diagJsonRecibido  * 1000000ULL
                        + (uint64_t)g_diagJsonEsCashOut *   10000ULL
                        + (uint64_t)g_diagCashOutFinish *     100ULL
                        + (uint64_t)g_diagSetHandpay;
                return true;
            }
            return false;

        // 0x03 hand paid cancelled credits.  Este sale del pulso de HAND PAY
        // propio de la placa, que es otra entrada distinta al cash out.
        case 0x03:
            *salida = (uint64_t)data_->HandPayMeter_prg * k;
            return true;

        // Sin fuente en esta placa: se contesta cero.  Aqui caen, entre
        // otros, el 0x02 -jackpot: esta maquina no paga premios-, el 0x01
        // -coin out-, el 0x17 y el 0x18 -transferencias AFT-, el 0x24
        // -drop- y el 0x25/0x26 -partidas-.  Todos son cero de verdad o
        // sencillamente no los podemos medir.
        //
        // El pulso de REFILL todavia no tiene medidor asignado.
        default:
            return false;
    }
}

// Atajo del de arriba.  Devuelve el valor y ya; el medidor sin fuente sale
// en cero.  Esta para que los long polls de medidor suelto -0x10, 0x11,
// 0x46- saquen el dato del MISMO lugar que el 0x2F y no puedan contradecirlo.
uint64_t SasEgm::medidorSas(uint8_t codigo) {
    uint64_t v = 0;
    obtenerValorMedidorRuta(codigo, &v);
    return v;
}

// ---------------------------------------------------------------------------
//  CUANTOS BYTES BCD OCUPA CADA MEDIDOR EN EL 0x2F
//
//  Antes daba por hecho que todos eran de 4 bytes.  No es cierto.  La nota
//  arriba de la tabla C-7 dice que el 0x2F reporta cada medidor con el "Min
//  Size" de la tabla, y ahi hay medidores de 5:
//
//     0x0D..0x10   tickets SAS en centavos
//     0x80..0xBE   tickets y transferencias AFT en centavos
//
//  Todo lo demas es de 4.
//
//  POR QUE IMPORTA AUNQUE ESTA PLACA NO TENGA TICKETS NI AFT:
//  el 0x2F no lleva separadores.  Si el host pide un medidor de 5 y le
//  contesto 4, TODO lo que viene detras se le recorre un byte y lee basura,
//  aunque el valor que mandamos sea cero.  Una placa que tiene que servirle a
//  cualquier host no puede suponer el tamano: lo tiene que saber.
// ---------------------------------------------------------------------------
static uint8_t tamanoMedidorSas(uint8_t codigo) {
    if (codigo >= 0x0D && codigo <= 0x10) return 5;
    if (codigo >= 0x80 && codigo <= 0xBE) return 5;
    return 4;
}

// ---------------------------------------------------------------------------
//  LONG POLL 0x2F  -  medidores selectos del juego N
//
//  Peticion:  01 2F <len> <juegoH> <juegoL> <cod>...<cod> <CRClo> <CRChi>
//  Respuesta: 01 2F <len> <juegoH> <juegoL> <cod><4 BCD>... <CRClo> <CRChi>
//
//  <len> cuenta lo que va DESPUES del propio byte de largo y ANTES del CRC.
// ---------------------------------------------------------------------------
bool SasEgm::procesarComandoContadoresDetallados(const uint8_t* trama,
                                                       uint16_t largoTrama) {
    if (trama == nullptr || largoTrama < 7) return false;

    const uint8_t lenPeticion = trama[2];

    // Minimo 2 (solo el numero de juego).  El tope lo pone nuestro buffer de
    // salida, no un numero magico.
    if (lenPeticion < 3) return false;
    const uint8_t nMedidores = (uint8_t)(lenPeticion - 2);
    if (nMedidores > SAS_MAX_MEDIDORES) return false;

    const uint16_t largoTotal = (uint16_t)(3 + lenPeticion + 2);
    if (largoTrama < largoTotal) return false;

    // CRC sobre todo menos los dos bytes del propio CRC.  Byte bajo primero.
    const uint16_t crcCalculado = calcularCrc16Kermit(trama, (uint16_t)(largoTotal - 2));
    const uint16_t crcTrama     = (uint16_t)(trama[largoTotal - 2] |
                                            (trama[largoTotal - 1] << 8));
    if (crcCalculado != crcTrama) { sasCrcMalos_++; return false; }

    temporizadorUltimoSas_ = HAL_GetTick();

    const uint8_t  gameNumH = trama[3];
    const uint8_t  gameNumL = trama[4];
    const uint8_t* codigos  = &trama[5];

    // Lo mas grande que puede salir de aqui: 3 de cabecera + 0x3E de datos
    // + 2 de CRC = 69 bytes.  Con 128 sobra.
    uint8_t  respuesta[128];
    uint16_t n = 0;

    respuesta[n++] = DIRECCION_SAS;
    respuesta[n++] = 0x2F;
    const uint16_t posLen = n;
    respuesta[n++] = 0x00;            // se rellena al final
    respuesta[n++] = gameNumH;
    respuesta[n++] = gameNumL;

    // SE CONTESTAN TODOS LOS QUE PIDAN, sin excepcion.
    //
    // Antes se omitian los que la placa no tiene y el host recibia una trama
    // mas corta que su peticion.  Eso deja a la maquina incompleta en la
    // pantalla del casino, y un host que indexe por posicion en vez de por
    // codigo se desincroniza entero.  Ahora la respuesta SIEMPRE espeja la
    // peticion: mismo numero de medidores, en el mismo orden.
    //
    // El que no tenemos va en cero fijo, y cero es el dato correcto: una
    // maquina de ruta sin contador de jackpots tiene, de verdad, cero
    // jackpots.
    for (uint8_t i = 0; i < nMedidores; i++) {
        const uint8_t codigo = codigos[i];

        uint64_t valor = 0;
        obtenerValorMedidorRuta(codigo, &valor);   // sin fuente -> queda en 0

        // Cada medidor con SU tamano, el que dice la tabla C-7.
        const uint8_t tamanoBcd = tamanoMedidorSas(codigo);

        // Dos topes, y los dos tienen que cumplirse:
        //
        //   1. el byte de largo del 0x2F no puede pasar de 0x3E (tabla 7.3b).
        //      Ese byte cuenta el numero de juego mas todos los pares, sin
        //      el CRC.  Si me paso, el byte se desborda y el host lee una
        //      trama de otro tamano del que de verdad mande.
        //   2. el buffer de salida.
        //
        // Si un host pide mas de lo que cabe, contesto lo que alcance en vez
        // de no contestar nada.  El manual lo permite y una respuesta corta
        // le sirve mas al host que el silencio.
        const uint16_t largoSiLoAgrego = (uint16_t)((n - 3) + 1 + tamanoBcd);
        if (largoSiLoAgrego > SAS_2F_LARGO_MAX) break;
        if ((uint16_t)(n + 1 + tamanoBcd + 2) > sizeof(respuesta)) break;

        respuesta[n++] = codigo;
        bcdEncodeSas(&respuesta[n], valor, tamanoBcd);
        n = (uint16_t)(n + tamanoBcd);
    }

    respuesta[posLen] = (uint8_t)(n - 3);

    const uint16_t crcRespuesta = calcularCrc16Kermit(respuesta, n);
    respuesta[n++] = (uint8_t)(crcRespuesta & 0xFF);
    respuesta[n++] = (uint8_t)((crcRespuesta >> 8) & 0xFF);

    enviarTramaSas(respuesta, n);
    return true;
}

// ---------------------------------------------------------------------------
//  Copia una cadena ASCII con LARGO FIJO.
//
//  Si es mas corta rellena con '0', si es mas larga la recorta.  Los campos
//  del 0x1F son de largo fijo y la trama no lleva byte de longitud: un
//  caracter de mas o de menos le corre TODO al host y le cambia el paytable
//  y el porcentaje de pago por basura.
//
//  Se rellena con '0' y no con espacio porque asi lo pide la tabla 7.10 para
//  el ID adicional, y prefiero un solo criterio para los cuatro campos.
// ---------------------------------------------------------------------------
static void copiarAsciiFijo(uint8_t* destino, const char* texto, uint8_t largo) {
    uint8_t i = 0;
    if (texto != nullptr) {
        for (; i < largo && texto[i] != '\0'; i++) destino[i] = (uint8_t)texto[i];
    }
    for (; i < largo; i++) destino[i] = (uint8_t)'0';
}

// ---------------------------------------------------------------------------
//  LONG POLL 0x1F  -  identidad de la maquina
//
//  Respuesta de 24 bytes, tabla 7.10 del SAS 6.02:
//
//    01 1F <ID 2 ASCII> <ID extra 3 ASCII> <denom 1> <apuesta max 1>
//          <grupo progresivo 1> <opciones 2> <paytable 6 ASCII>
//          <porcentaje 4 ASCII> <CRC 2>
//
//  NO lleva byte de longitud: es de largo fijo y el host cuenta posiciones.
//
//  Tres de estos campos -denominacion, apuesta maxima y porcentaje- los
//  define el casino o la jurisdiccion, no yo.  Van en cero hasta que me
//  pasen los buenos: prefiero que se note que faltan a inventar un numero
//  que el host se crea y que despues no cuadre con el alta de la maquina.
// ---------------------------------------------------------------------------
void SasEgm::responderIdentidadMaquina() {
    uint8_t  r[24];
    uint16_t n = 0;

    r[n++] = DIRECCION_SAS;
    r[n++] = 0x1F;

    copiarAsciiFijo(&r[n], ID_JUEGO_ASCII,       2);  n += 2;
    copiarAsciiFijo(&r[n], ID_JUEGO_EXTRA_ASCII, 3);  n += 3;

    r[n++] = CODIGO_DENOMINACION;
    r[n++] = APUESTA_MAXIMA;
    r[n++] = GRUPO_PROGRESIVO;
    r[n++] = OPCIONES_JUEGO_HI;
    r[n++] = OPCIONES_JUEGO_LO;

    copiarAsciiFijo(&r[n], ID_PAYTABLE_ASCII,     6);  n += 6;
    copiarAsciiFijo(&r[n], PORCENTAJE_PAGO_ASCII, 4);  n += 4;

    const uint16_t crc = calcularCrc16Kermit(r, n);
    r[n++] = (uint8_t)(crc & 0xFF);
    r[n++] = (uint8_t)((crc >> 8) & 0xFF);
    enviarTramaSas(r, n);
}

// ---------------------------------------------------------------------------
//  LONG POLL 0x1B  -  informacion del hand pay
//
//  Respuesta de 24 bytes, tabla 7.8 del SAS 6.02:
//
//    01 1B <grupo 1> <nivel 1> <monto 5 BCD> <pago parcial 2 BCD>
//          <reset ID 1> <10 bytes sin usar> <CRC 2>
//
//  Nivel = 0x80, que en la tabla es "cancelled credits amount".  Es lo
//  correcto para esta placa: aqui no hay premios ni progresivos, el unico
//  hand pay que existe es el cash out del saldo, o sea creditos cancelados.
//  -Mi otro proyecto manda 0x00 en este campo, que significa "premio no
//  progresivo".  Ahi quedo pendiente cambiarlo.-
//
//  El monto va en unidades de la denominacion SAS -creditos-, NO en centavos.
//  Eso lo dice la tabla: solo cuando el hand pay trae parte de un progresivo
//  el monto se manda en centavos, y aqui nunca es el caso.
//
//  Si no hay hand pay trabado sale todo en ceros.  Asi lo pide la seccion
//  7.8.2: "long poll 1B returns all zeros whenever the gaming machine is not
//  currently in a handpay lockup".
// ---------------------------------------------------------------------------
void SasEgm::responderHandpayInfo() {
    uint8_t  r[24];
    for (uint8_t i = 0; i < sizeof(r); i++) r[i] = 0x00;

    r[0] = DIRECCION_SAS;
    r[1] = 0x1B;

    if (g_handpayPendiente) {
        r[2] = 0x00;   // grupo progresivo: ninguno
        r[3] = 0x80;   // nivel: creditos cancelados

        // Monto en 5 BCD.  r[9] y r[10] -pago parcial- quedan en cero: aqui
        // no se paga nada por adelantado, el cash out sale completo.
        // r[11] -reset ID- en cero: solo hay reset estandar, esta placa no
        // sabe devolver el hand pay al medidor de creditos.
        //
        // La unidad la decide HANDPAY_1B_EN_CENTAVOS.  Ver la nota larga en
        // el .h: el manual pide creditos, pero mi host divide este campo
        // entre 100 y por eso diez dolares salian como $0,10.
        uint64_t monto = (uint64_t)g_handpayMonto * (uint64_t)SAS_CREDITOS_POR_PULSO;
        if (HANDPAY_1B_EN_CENTAVOS) monto *= (uint64_t)CENTAVOS_POR_CREDITO;

        bcdEncodeSas(&r[4], monto, 5);
    }

    const uint16_t crc = calcularCrc16Kermit(r, 22);
    r[22] = (uint8_t)(crc & 0xFF);
    r[23] = (uint8_t)((crc >> 8) & 0xFF);
    enviarTramaSas(r, 24);

    // -------------------------------------------------------------------
    //  REPORTADO = FUERA DE LA COLA
    //
    //  Esta placa NO se traba esperando al tecnico: pulsa el hopper, paga y
    //  sigue.  Asi que en cuanto el host pregunta por el pago, el pago ya
    //  esta hecho y la ficha se cierra aqui mismo.
    //
    //  Sin esto el monto se quedaba pendiente para siempre, el siguiente
    //  cash out le sumaba encima, y el 0x1B iba reportando 10, 20, 30, 40.
    //
    //  Y se avisa con la excepcion 0x52 -hand pay reseteado-, que es lo que
    //  pide la 7.8.1 una vez que el 0x1B se contesto y el pago se resolvio.
    //  Asi el host cierra su lado en vez de quedarse esperando un 0x94 que
    //  en esta placa nunca va a hacer falta.
    //
    //  Riesgo asumido: si la respuesta se pierde en el aire, el host vuelve
    //  a pedir el 0x1B y recibe ceros.  Prefiero eso a un monto que crece
    //  solo, que es dinero mal reportado.
    // -------------------------------------------------------------------
    if (g_handpayPendiente) {
        g_handpayPendiente = false;
        g_handpayMonto     = 0;
        encolarExcepcionSas(SAS_EXC_HANDPAY_RESETEADO);
    }
}

// ---------------------------------------------------------------------------
//  DESPACHADOR DE LONG POLLS
// ---------------------------------------------------------------------------
void SasEgm::ProcesarComandoSAS(const uint8_t* trama, uint16_t largoTrama) {
    if (largoTrama < 2)              return;
    if (trama[0] != DIRECCION_SAS)   return;   // es para otra maquina del bus

    sasTramasAtendidas_++;

    const uint8_t comando = trama[1];
    const uint64_t k = (uint64_t)SAS_CREDITOS_POR_PULSO;

    switch (comando) {
        case 0x2F:
            procesarComandoContadoresDetallados(trama, largoTrama);
            break;

        // 0x1A = creditos actuales.  Lo que el jugador tiene en pantalla
        // ahora mismo, no un acumulado.  Lo lleva actualizarCreditoPorPulsos()
        // y lo mueven los setters set_CurrentCredit() y set_Handpay().
        case 0x1A:
            responderContadorBCD(0x1A, (uint64_t)g_creditoActual * k);
            break;

        // ------------------------------------------------------------------
        //  0x54 = que version de SAS hablo y cual es mi numero de serie.
        //
        //  Respuesta:  01 54 <largo> <3 ASCII version> <serie ASCII> <CRC16>
        //  El <largo> cuenta version + serie, sin contar el CRC.
        //
        //  Los dos campos van en ASCII, NO en BCD.  Es de los pocos long
        //  polls que mandan texto, asi que no se puede usar el codificador
        //  BCD de los medidores.
        // ------------------------------------------------------------------
        case 0x54: {
            uint8_t r[64];
            uint16_t n = 0;

            r[n++] = DIRECCION_SAS;
            r[n++] = 0x54;
            const uint16_t posLen = n;
            r[n++] = 0x00;                       // se rellena al final

            for (const char* p = SAS_VERSION_ASCII; *p && n < 60; ++p) r[n++] = (uint8_t)*p;
            for (const char* p = SERIE_MAQUINA;     *p && n < 60; ++p) r[n++] = (uint8_t)*p;

            r[posLen] = (uint8_t)(n - 3);

            const uint16_t c = calcularCrc16Kermit(r, n);
            r[n++] = (uint8_t)(c & 0xFF);
            r[n++] = (uint8_t)((c >> 8) & 0xFF);
            enviarTramaSas(r, n);
            break;
        }

        // ------------------------------------------------------------------
        //  0xA0 = que funciones tengo habilitadas.
        //
        //  Peticion:   01 A0 <juegoH> <juegoL> <CRC16>
        //  Respuesta:  01 A0 <juegoH> <juegoL> <3 de features> <3 reservados> <CRC16>
        //
        //  Esta trama NO lleva byte de largo: es de tamano fijo, 12 bytes.
        //
        //  Los tres bytes de features van en CERO: son banderas de cosas que
        //  esta placa no hace -AFT, bonos, torneos, validacion de tickets-.
        //  Prender un bit aqui es prometerle al host algo que despues va a
        //  pedir y no vamos a saber contestar.
        // ------------------------------------------------------------------
        case 0xA0: {
            uint8_t r[16];
            uint16_t n = 0;

            r[n++] = DIRECCION_SAS;
            r[n++] = 0xA0;

            // Le devuelvo el mismo numero de juego que me pidio.  Si la
            // trama venia corta, contesto el juego 0000, que es la maquina
            // completa.
            r[n++] = (largoTrama >= 4) ? trama[2] : 0x00;
            r[n++] = (largoTrama >= 4) ? trama[3] : 0x00;

            r[n++] = 0x00; r[n++] = 0x00; r[n++] = 0x00;   // features
            r[n++] = 0x00; r[n++] = 0x00; r[n++] = 0x00;   // reservados

            const uint16_t c = calcularCrc16Kermit(r, n);
            r[n++] = (uint8_t)(c & 0xFF);
            r[n++] = (uint8_t)((c >> 8) & 0xFF);
            enviarTramaSas(r, n);
            break;
        }

        // ------------------------------------------------------------------
        //  MEDIDORES SUELTOS  (long polls 0x10 a 0x18)
        //
        //  Todos salen de obtenerValorMedidorRuta(), el MISMO puente que usa
        //  el 0x2F.  Antes el 0x11 y el 0x12 leian data_-> por su cuenta y eso
        //  daba dos caminos para el mismo dato: el dia que uno cambie, el
        //  host recibe numeros distintos segun por donde pregunte, y no hay
        //  forma de saber cual de los dos es el bueno.
        //
        //  Ojo con los codigos: el numero del LONG POLL y el numero del
        //  MEDIDOR son dos numeraciones distintas.  El long poll 0x11 pide el
        //  medidor 0x00, no el 0x11.
        // ------------------------------------------------------------------

        // 0x10 total cancelled credits -> medidor 0x04.  Es el cash out.
        case 0x10: responderContadorBCD(0x10, medidorSas(0x04)); break;

        // 0x11 total coin in -> medidor 0x00.  En SAS "coin in" es el total
        // apostado, o sea el BET.
        case 0x11: responderContadorBCD(0x11, medidorSas(0x00)); break;

        // 0x12 total coin out: CERO, y es un cambio a proposito.
        //
        // Antes contestaba el HopperMeter, que es el mismo numero que el
        // 0x10.  Eso es doble contabilidad: "coin out" es lo que la maquina
        // PAGA por premios, y el cash out ya va reportado como creditos
        // cancelados.  Un host que calcule neto = coin in - coin out -
        // cancelados restaba el cash out dos veces.
        //
        // Esta placa no tiene de donde sacar los premios pagados, asi que va
        // en cero, igual que en el 0x2F.
        case 0x12: responderContadorBCD(0x12, 0); break;

        // 0x13 total drop: cero.  No hay caja de caida en esta placa.
        // PENDIENTE: si la jurisdiccion cuenta los billetes del stacker como
        // drop, esto hay que revisarlo, porque entonces no es cero.
        case 0x13: responderContadorBCD(0x13, 0); break;

        // 0x14 total jackpot: cero de verdad.  Aqui no hay premios ni
        // progresivos; el unico dinero que sale es el cash out, y ese ya va
        // por el 0x10 y el 0x23.
        case 0x14: responderContadorBCD(0x14, 0); break;

        // Partidas jugadas / ganadas / perdidas.  La placa no tiene pulso de
        // los que salgan, asi que van en cero.  Verificado en la maquina
        // real: 0x15 = jugadas, 0x16 = ganadas, 0x17 = perdidas, y ademas
        // 0x17 = 0x15 - 0x16 clavado (3594 - 776 = 2818).
        case 0x15: responderContadorBCD(0x15, 0); break;
        case 0x16: responderContadorBCD(0x16, 0); break;
        case 0x17: responderContadorBCD(0x17, 0); break;

        // 0x18 partidas desde el ultimo encendido y desde que se cerro la
        // puerta.  Son DOS medidores de 2 BCD, no uno de 4, pero como los dos
        // van en cero la trama sale igual de 8 bytes y el host la lee bien.
        //
        // Con DIAG_CASHOUT_EN_0x18 en true este long poll deja de ser un
        // medidor y se convierte en el tablero del cash out remoto.  Los
        // cuatro bytes son cuatro contadores, no un numero: por eso se arman
        // a mano y NO pasan por el codificador BCD, que interpretaria los
        // cuatro juntos como un solo valor de ocho digitos.
        case 0x18:
            if (DIAG_CASHOUT_EN_0x18) {
                uint8_t r[8];
                r[0] = DIRECCION_SAS;
                r[1] = 0x18;
                r[2] = (uint8_t)(((g_diagJsonRecibido  / 10) << 4) | (g_diagJsonRecibido  % 10));
                r[3] = (uint8_t)(((g_diagJsonEsCashOut / 10) << 4) | (g_diagJsonEsCashOut % 10));
                r[4] = (uint8_t)(((g_diagCashOutFinish / 10) << 4) | (g_diagCashOutFinish % 10));
                r[5] = (uint8_t)(((g_diagSetHandpay    / 10) << 4) | (g_diagSetHandpay    % 10));
                const uint16_t c = calcularCrc16Kermit(r, 6);
                r[6] = (uint8_t)(c & 0xFF);
                r[7] = (uint8_t)((c >> 8) & 0xFF);
                enviarTramaSas(r, 8);
            } else {
                responderContadorBCD(0x18, 0);
            }
            break;

        // ------------------------------------------------------------------
        //  BLOQUES DE VARIOS MEDIDORES  (0x0F y 0x19)
        //
        //  Son los mismos medidores de arriba pero en una sola trama.  El
        //  orden lo fija la tabla 7.2a/7.2b y NO se puede cambiar: el host
        //  cuenta posiciones, no lee codigos.
        //
        //  Salen del mismo puente que los sueltos, asi que no hay manera de
        //  que el 0x0F y el 0x11 se contradigan.
        // ------------------------------------------------------------------

        // 0x0F: cancelados, coin in, coin out, drop, jackpot, jugadas.
        case 0x0F: {
            const uint64_t v[6] = {
                medidorSas(0x04),   // total cancelled credits
                medidorSas(0x00),   // total coin in  (= BET)
                0,                  // total coin out  - sin fuente
                0,                  // total drop      - no hay
                0,                  // total jackpot   - no hay
                0                   // games played    - sin fuente
            };
            responderBloqueMedidores(0x0F, v, 6);
            break;
        }

        // 0x19: lo mismo sin los cancelados.
        case 0x19: {
            const uint64_t v[5] = {
                medidorSas(0x00),   // total coin in  (= BET)
                0,                  // total coin out
                0,                  // total drop
                0,                  // total jackpot
                0                   // games played
            };
            responderBloqueMedidores(0x19, v, 5);
            break;
        }

        // ------------------------------------------------------------------
        //  0x46 = creditos de todos los billetes aceptados
        //
        //  Este SI lo tenemos de verdad y con la unidad correcta: la tabla
        //  B-1 lo pide "in SAS accounting denom units", o sea en creditos,
        //  que es exactamente lo que cuenta el billetero de esta placa.
        //  Es el mismo dato del medidor 0x0B.
        // ------------------------------------------------------------------
        case 0x46: responderContadorBCD(0x46, medidorSas(0x0B)); break;

        // ------------------------------------------------------------------
        //  0x20 = valor en DOLARES de todos los billetes aceptados
        //
        //  Este lo tuve callado mientras no sabia la denominacion, porque
        //  sin ella no hay forma de convertir creditos a dinero.  Ya la se:
        //  un credito es un dolar, asi que el valor en dolares es el MISMO
        //  numero que el 0x46 y no hay nada que multiplicar.
        //
        //  Ojo si algun dia la placa cambia de denominacion: aqui hay que
        //  multiplicar por los dolares que valga un credito.  Hoy es x1 y
        //  por eso no se ve la multiplicacion.
        // ------------------------------------------------------------------
        case 0x20: responderContadorBCD(0x20, medidorSas(0x0B)); break;

        // 0x1B: ficha del hand pay trabado.  Si no hay ninguno sale en ceros.
        case 0x1B:
            responderHandpayInfo();
            break;

        // 0x1F: identidad de la maquina.
        case 0x1F:
            responderIdentidadMaquina();
            break;

        // ------------------------------------------------------------------
        //  0x0A / 0x0B = entrar y salir de modo mantenimiento
        //
        //  Se contestan con un ACK de un byte.  Es honesto: el modo
        //  mantenimiento solo sirve para que no suene la alarma de puerta
        //  abierta mientras el tecnico trabaja, y esta placa no tiene alarma
        //  de puerta, o sea que no hay nada que hacer y nada que prometer.
        //  Guardo la bandera nada mas para verla en el debugger.
        // ------------------------------------------------------------------
        case 0x0A:
            g_modoMantenimiento = true;
            responderAckSimple();
            break;
        case 0x0B:
            g_modoMantenimiento = false;
            responderAckSimple();
            break;

        // ------------------------------------------------------------------
        //  0x94 = reset remoto del hand pay
        //
        //  El host nos dice que ya pago y que soltemos el bloqueo.  Se borra
        //  la ficha del 0x1B y se avisa con la excepcion 0x52.
        //
        //  LIMITACION CONOCIDA: la trama trae un byte de codigo -00 reset
        //  normal, 01 devolver el hand pay al medidor de creditos- que aqui
        //  no llega a leerse, porque el ensamblador cierra estos long polls
        //  en direccion + comando.  Cualquier 0x94 se trata como reset
        //  normal.  Para esta placa da igual: no sabemos devolver creditos.
        // ------------------------------------------------------------------
        case 0x94:
            g_handpayPendiente = false;
            g_handpayMonto     = 0;
            encolarExcepcionSas(SAS_EXC_HANDPAY_RESETEADO);
            responderAckSimple();
            break;

        // ------------------------------------------------------------------
        //  LO QUE NO SE CONTESTA A PROPOSITO
        //
        //  En SAS callar es una respuesta valida; inventar una trama no.  La
        //  tabla 7.1b lo dice claro: un medidor que uno SABE que vale cero se
        //  contesta con cero, pero un medidor que uno simplemente no puede
        //  medir se tiene que IGNORAR.  Contestar cero ahi es afirmar algo
        //  que no nos consta.
        //
        //    0x1E  billetes por denominacion.  Este sigue callado aunque ya
        //          sepa la denominacion de la MAQUINA, porque son dos cosas
        //          distintas: yo se que un credito vale un dolar, pero no se
        //          si los veinte creditos que acaban de entrar fueron un
        //          billete de veinte o veinte billetes de uno.  La placa
        //          cuenta pulsos, no billetes.
        //
        //          Contestar seis ceros mientras el 0x0B trae miles de
        //          creditos es contradecirse solo, y en una auditoria eso se
        //          lee como maquina manipulada.
        //
        //    0x2D  cancelados por numero de juego.  Habria que leer el juego
        //          que viene en la peticion, y el ensamblador cierra este
        //          long poll antes de esos bytes.
        //
        //    0x01..0x07  apagar/encender la maquina, el sonido y el
        //          billetero.  Esta placa LEE pulsos, no manda nada a la
        //          maquina.  Contestar ACK aqui seria decirle al host
        //          "listo, ya deshabilite el billetero" mientras el billetero
        //          sigue tragando dinero.  Eso es peor que no contestar.
        //
        //    0x73  registro de AFT.  El host no lo usa: manda la llave de
        //          registro en ceros dentro del 0x72, que significa "no hace
        //          falta registrarse".
        // ------------------------------------------------------------------

        // ------------------------------------------------------------------
        //  AFT.  Aqui empieza el cash out remoto de verdad.
        //
        //  Antes los dejaba callados a proposito, con el argumento de que
        //  contestarlos le prometia al host una capacidad inexistente.  El
        //  argumento era bueno y la conclusion estaba mal: el host NO usa
        //  JSON para el cash out remoto, usa AFT.  Callarse no era prudencia,
        //  era dejar el cash out sin disparador.
        // ------------------------------------------------------------------
        case 0x74:
            responderAftLockStatus(trama, largoTrama);
            break;

        case 0x72:
            responderAftTransfer(trama, largoTrama);
            break;

        default:
            break;
    }
}

// ---------------------------------------------------------------------------
//  ATENCION DEL BUS  -  se llama en cada vuelta del lazo
// ---------------------------------------------------------------------------
void SasEgm::atenderSas() {
    uint32_t edadMs = 0;
    uint16_t n      = 0;

    // Se vacia la cola hasta dar con una trama FRESCA.  Si nos atrasamos, las
    // viejas se tiran: contestar tarde es peor que no contestar, porque la
    // respuesta se le cruza al host con su siguiente poleo y le rompe la
    // trama buena.
    while ((n = rx_.readFrame(bufferRecepcionSas_,
                                sizeof(bufferRecepcionSas_), &edadMs)) > 0) {
        if (edadMs <= SAS_EDAD_MAXIMA_MS) break;
    }
    if (n == 0) return;

    // Llego algo: el enlace esta vivo.  Si venia caido, el host acaba de
    // volver y no hay nada que hacer para retomar: la placa contesta lo que
    // le pregunten, como siempre.  Solo se anota para el diagnostico.
    g_msUltimaTrama = HAL_GetTick();
    g_enlaceArriba  = true;

    // --- POLEO GENERAL: un solo byte ---------------------------------------
    if (n == 1) {
        const uint8_t direccion = bufferRecepcionSas_[0];

        if (direccion == (uint8_t)(DIRECCION_SAS | 0x80)) {
            // Es para nosotros.
            uint8_t excepcion = 0x00;     // 0x00 = sin novedad

            if (EXCEPCIONES_SAS_ACTIVO) {
                if (g_excEnVuelo) {
                    // El host REPITIO el mismo poleo general sin haber
                    // acusado la excepcion anterior.  Eso es un NACK
                    // implicito -SAS 6.02 seccion 3.2-: no la recibio bien.
                    // Se manda LA MISMA otra vez.
                    //
                    // Si en vez de esto se borrara al transmitir, el
                    // reintento del host contestaria 0x00 y el evento se
                    // perderia para siempre.  Un hand pay perdido es dinero
                    // que el sistema nunca se entero que salio.
                    excepcion = g_excEnVueloCodigo;
                    sasNackImplicitos_++;
                }
                else if (g_excPendiente != 0x00) {
                    excepcion          = g_excPendiente;
                    g_excEnVuelo       = true;
                    g_excEnVueloCodigo = g_excPendiente;
                    g_excPendiente     = 0x00;
                }
            }

            rx_.write(&excepcion, 1);
            sasPoleosContestados_++;
            return;
        }

        // Poleo general dirigido a OTRA maquina del bus.  No se contesta,
        // pero segun la tabla 3.1 cuenta como acuse de recibo de nuestra
        // excepcion: el host siguio adelante con su ronda, o sea que la
        // recibio bien.
        if ((direccion & 0x80) && EXCEPCIONES_SAS_ACTIVO) {
            g_excEnVuelo = false;
        }
        return;
    }

    // --- LONG POLL ---------------------------------------------------------
    //
    // Un long poll dirigido a nosotros tambien acusa recibo de la excepcion
    // -tabla 3.1-.  Se marca ANTES de contestar, porque la respuesta al long
    // poll puede levantar una excepcion nueva y esa no debe darse por
    // entregada de una vez.
    if (EXCEPCIONES_SAS_ACTIVO) {
        g_excEnVuelo = false;
    }

    ProcesarComandoSAS(bufferRecepcionSas_, n);
}

// ---------------------------------------------------------------------------
//  MODOS DE PRUEBA
//
//  Sirven para verificar el enlace SAS sin tener la maquina enfrente: la
//  placa se inventa un cash in y un hand pay y yo los veo pasar en el
//  sniffer.  Cada uno se enciende por separado desde su bandera en el .h.
//
//  Los dos disparan UNA SOLA VEZ por arranque.  Para repetir la prueba hay
//  que resetear la placa.
//
//  Cuentan desde que la maquina llega a su estado de reposo, no desde el
//  encendido: antes de eso el enlace SAS todavia no esta arriba y el host no
//  veria el cambio.
// ---------------------------------------------------------------------------
void SasEgm::correrModosDePrueba(bool enReposo) {
    // Si en este arranque se borro la memoria, estos modos NO corren.
    //
    // Lo encontre en el banco: el borrado y el modo de creditos disparan los
    // dos a los 10 segundos, y como el borrado va primero en el lazo, la
    // secuencia quedaba "borro todo -> meto 200 creditos" en la misma vuelta.
    // Uno borra la memoria y ve 200 creditos aparecer: desconcertante, y
    // ademas deja la EEPROM sucia otra vez en el proximo guardado.
    if (g_memoriaBorrada) return;

    static bool hechoCreditos = false;
    static bool hechoHandpay  = false;
    static uint32_t msReposo  = 0;

    if (!enReposo) return;

    // Primera vez que llego al reposo: de aqui arrancan los dos relojes.
    if (msReposo == 0) msReposo = HAL_GetTick();

    const uint32_t transcurrido = HAL_GetTick() - msReposo;

    // --- Modo creditos: pone el 0x1A en el monto configurado --------------
    // El 0x0B sube en la misma cantidad, porque ese credito entro por el
    // billetero y la contabilidad tiene que cuadrar.
    if (TEST_CREDITOS_ACTIVO && !hechoCreditos &&
        transcurrido >= TEST_CREDITOS_MS) {
        set_CurrentCredit(TEST_CREDITOS_MONTO);
        hechoCreditos = true;
    }

    // --- Modo hand pay: paga y baja el saldo ------------------------------
    // Sube el 0x23 y el 0x04, y deja el 0x1A en cero.  Va mas tarde que el
    // de creditos a proposito: asi en el sniffer se ve primero entrar el
    // dinero y despues salir, que es el ciclo completo.
    if (TEST_HANDPAY_ACTIVO && !hechoHandpay &&
        transcurrido >= TEST_HANDPAY_MS) {
        set_Handpay(TEST_HANDPAY_MONTO);
        hechoHandpay = true;
    }
}

// ---------------------------------------------------------------------------
//  SIMULADOR DE PRUEBA DE ESTRES
//
//  Mete dinero y lo saca, en ciclo, hasta que apague la placa.  Dos fases
//  que se alternan cada STRESS_PERIODO_MS:
//
//     fase 1  CASH IN   sube el saldo y el 0x0B, y avisa con la excepcion
//                       0x4F -billete aceptado-.
//     fase 0  CASH OUT  mete la maquina a Proceso_Cash_Out de VERDAD.  De
//                       ahi en adelante corre la FSM del hopper como
//                       siempre: saca los pulsos, llega a Finish y registra
//                       el pago, que a su vez encola la excepcion 0x51.
//
//  La fase de cash out NO llama a set_Handpay por su cuenta.  Es a
//  proposito: si la llamara estaria probando mi propio atajo en vez del
//  camino real, y lo que quiero saber es si el camino real funciona.
//
//  Solo arranca un ciclo con la maquina en reposo.  Asi nunca le cae encima
//  a un cash out que ya esta corriendo -ni al mio ni al de la pagina-.
// ---------------------------------------------------------------------------
bool SasEgm::correrPruebaEstres(bool enReposo) {
    if (!STRESS_ACTIVO)   return false;
    if (g_memoriaBorrada) return false;
    if (!enReposo)        return false;

    static uint32_t timer = 0;
    static uint8_t  fase  = 0;

    if (timer == 0) timer = HAL_GetTick();
    if ((HAL_GetTick() - timer) < STRESS_PERIODO_MS) return false;
    timer = HAL_GetTick();

    fase = (uint8_t)(fase ^ 1);

    if (fase == 1) {
        // ---- CASH IN ----
        set_CurrentCredit(creditoActual() + STRESS_MONTO);
        encolarExcepcionSas(SAS_EXC_BILLETE_ACEPTADO);

        // Pulsos fisicos por la entrada de monedas, como el simulador del
        // ConversorApp.  En el banco no regresan -el lazo esta abierto- asi
        // que no mueven ningun medidor; estan para que la prueba se parezca
        // mas a una maquina de verdad.
        if (STRESS_CON_PULSOS) {
            GeneradorPulsos::getInstance()->addPulses(STRESS_MONTO);
        }
    }
    else {
        // ---- CASH OUT ----
        // Si no hay saldo no hay nada que pagar, y entrar al estado para
        // pagar cero solo ensuciaria el log con pulsos vacios.
        //
        // Se DEVUELVE la peticion en vez de cambiar el estado desde aqui.  El
        // SAS no es dueno de la maquina: pide un cash out y quien manda
        // decide si se lo concede.  Asi tampoco necesita conocer los estados
        // de StateMachine, que es lo que lo ataba a ella.
        if (creditoActual() > 0) return true;
    }
    return false;
}

// ---------------------------------------------------------------------------
//  REEMISION DE LA EXCEPCION 0x51
//
//  Seccion 7.8.1 del SAS 6.02: si el host no viene por el 0x1B dentro de los
//  quince segundos siguientes al aviso, hay que repetirlo, y seguir
//  repitiendolo cada quince segundos mientras el hand pay siga pendiente.
//
//  El reloj se reinicia cada vez que se encola la excepcion, asi que la
//  primera reemision cae quince segundos despues del aviso original y no
//  quince segundos despues del arranque.
//
//  Ojo con la diferencia entre las dos banderas: g_excPendiente es "hay algo
//  que mandar en el proximo poleo" y g_excEnVuelo es "ya lo mande pero el
//  host no lo ha acusado".  Solo reemito cuando las DOS estan en falso, o
//  sea cuando el aviso ya se dio por entregado y aun asi el host nunca vino
//  a preguntar.  Reemitir con una en vuelo seria pisar el reintento que ya
//  maneja atenderSas().
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
//  VIGILANCIA DEL ENLACE
//
//  Corre en cada vuelta del lazo.  Dos trabajos: darse cuenta de que el host
//  se fue, y -si esta encendido el latido- avisar que seguimos vivos.
// ---------------------------------------------------------------------------
bool SasEgm::enlaceArriba() const {
    return g_enlaceArriba;
}


void SasEgm::vigilarEnlace() {
    const uint32_t ahora = HAL_GetTick();

    // --- se cayo? ------------------------------------------------------
    if (g_enlaceArriba && (ahora - g_msUltimaTrama) >= ENLACE_TIMEOUT_MS) {
        g_enlaceArriba = false;
        g_caidasEnlace++;

        // Limpieza de lo que quedo a medias.  Esto NO depende de ninguna
        // bandera: es correccion, no una funcion opcional.
        //
        //   - el bloqueo de AFT se suelta.  Lo pide el manual: una maquina
        //     que entra en link down estando bloqueada tiene que volver a
        //     "no locked".  Si no, queda muerta esperando a un host que ya
        //     no esta.
        //   - la excepcion "en vuelo" se tira.  Esa conversacion se murio
        //     con el host viejo; reenviarsela al que vuelva seria contarle
        //     el final de una historia que nunca escucho.
        //
        // Lo que SI se conserva es g_excPendiente: si hubo un hand pay
        // mientras el host no estaba, se le cuenta en cuanto vuelva.
        liberarBloqueoAft();
        g_excEnVuelo = false;
    }

    // --- el latido ------------------------------------------------------
    if (!g_enlaceArriba && LATIDO_ENLACE_ACTIVO) {
        if ((ahora - g_msUltimoLatido) >= LATIDO_PERIODO_MS) {
            g_msUltimoLatido = ahora;
            const uint8_t b = LATIDO_BYTE;
            rx_.write(&b, 1);
        }
    }
}

void SasEgm::reemitirExcepcionHandpay() {
    if (!EXCEPCIONES_SAS_ACTIVO) return;
    if (!g_handpayPendiente)     return;
    if (g_excPendiente != 0x00 || g_excEnVuelo) return;

    if ((HAL_GetTick() - g_msUltimaExc51) < SAS_REEMITIR_51_MS) return;

    encolarExcepcionSas(SAS_EXC_HANDPAY_PENDIENTE);
}

