State StateMachine::ProcesarJsonRecibido( uint8_t* json_buffer) {
    int status = CrearJson_obj->Recibe_JSON(json_buffer);
    switch (status) {
        case Cadena_NO_valida:
            // Serial->Println("Cadena no valida");
        	memset(JSON_datos_recibidos,0,sizeof(JSON_datos_recibidos));
		    buffer = 0;
            return State::Estado_Recepcion_Json;

        case Reset_Meters:
        	 data->Evento_Reset = 1;
        	 memset(JSON_datos_recibidos,0,sizeof(JSON_datos_recibidos));
			 buffer = 0;
             return State::Estado_Reset_Meters_JSON;

/*
        case Test_Salida:
			data.Testeo_Salida = 1;
			CrearJson_obj.Obtener_S1(json_buffer, &data.Pulsos_S1);
			 memset(JSON_datos_recibidos,0,sizeof(JSON_datos_recibidos));
			 buffer = 0;
			 Serial->Println("Probando salidas");
			return State::Recepcion_Json;
*/

        case WEMOS_listo:
        	memset(JSON_datos_recibidos,0,sizeof(JSON_datos_recibidos));
		    buffer = 0;
            return State::Estado_Recepcion_Json;

        case Solicitud_de_Estado:
        	memset(JSON_datos_recibidos,0,sizeof(JSON_datos_recibidos));
			buffer = 0;
			return State::Estado_Solicitud_de_Estado_Contadores;

        case Solicitud_de_FW:
        	memset(JSON_datos_recibidos,0,sizeof(JSON_datos_recibidos));
			buffer = 0;
        	return State::Estado_Solicitud_de_Version;

        case Diagnostico:
        	memset(JSON_datos_recibidos,0,sizeof(JSON_datos_recibidos));
			buffer = 0;
			return State::Estado_Diagnostico_STM32;


        case Solicitud_Cash_Out:
        	  memset(JSON_datos_recibidos,0,sizeof(JSON_datos_recibidos));
			  buffer = 0;
			 return State::Proceso_Cash_Out;

        case Solicitud_Cash_In:
        	if( CrearJson_obj->Decodifica_Solicitud_Cash_In( JSON_datos_recibidos, Creditos, TiempoPulso_In)){
          	 memset(JSON_datos_recibidos,0,sizeof(JSON_datos_recibidos));
  			 buffer = 0;
  			 return State::Proceso_Cash_In;
        	}else{
        		 memset(JSON_datos_recibidos,0,sizeof(JSON_datos_recibidos));
				 buffer = 0;
				 return State::Estado_Recepcion_Json;
        	}


        default:
            return State::Estado_Recepcion_Json;
    }
}


// Implementación de handleInicio
State StateMachine::handleInicio(volatile Flags &Obj_Flags) {
	 if (!flag_DELAY_INICIO)
		 {
			 tickInicio = HAL_GetTick();   // Guarda el tiempo inicial
			 if (_hiwdg != nullptr)  HAL_IWDG_Refresh(_hiwdg);
			 flag_DELAY_INICIO = true;
			// Serial->Println("{\"egm\":1000,\"evt\":\"ever\",\"sta\":\"end\",\"ver\":\"5.06\"}");
		 }

	  if  (HAL_GetTick() - tickInicio >= DELAY_INICIO_MS)
		{
	    // Aquí ya pasó el delay de 500 ms, señales estabilizadas
			 flag_DELAY_INICIO = false;

	    Serial->init(huart_Serial);

        // Inicializar metros
        InitMeters(Obj_Flags);


        // Iniciar periféricos
        IniciarTimer();

        // Obtener causa de reset
        g_reset_cause = Obtener_Causa_Reset();

        // Limpiar flags
        limpiarFlags(Obj_Flags);

        // Inicializar señales
        InitSignals(Obj_Flags);

        //Inicia Generación de pulsos (CASH IN REMOTO)
        GeneradorPulsos::getInstance()->init(GPIOA, Coin_IN_Pin);

        sas->begin(huart_Serial_SAS);

        sas->vincularContadores(data->Total_In_Meter_prg,
        		                data->Total_BET_meter ,
								data->HopperMeter_prg,
								data->HandPayMeter_prg);



        //Serial->Println("Inicio OK");
        // Transición al siguiente estado
        return State::Estado_Recepcion_Json;
    }

    // Permanecer en el mismo estado
    return State::Estado_Inicio;
}


// Implementación de handleRecepcionJson
State StateMachine::handleRecepcionJson() {
    // Intentar leer mensaje serial
	 if (LeerMensajeSerial( JSON_datos_recibidos, sizeof(JSON_datos_recibidos))) {
		 currentState = ProcesarJsonRecibido(JSON_datos_recibidos);
		 memset(JSON_datos_recibidos, 0, sizeof(JSON_datos_recibidos));
		 return currentState;
	 }

    // Manejar timers
	// Serial->Println("Manejar timers");
    handleTimers();

    // Procesar señales
    procesarTodasLasSignales();

    // Revisar sino ha caido el voltaje

    return State::Caida_de_Voltaje;
   // return State::Estado_Recepcion_Json;

}


State StateMachine::ResetContadores()
{
	memset(data->flash_data,0,sizeof(data->flash_data));
	 HAL_I2C_Mem_Write(hi2c2, data->DIRECCION_I2C_MEM, data->Word_address, I2C_MEMADD_SIZE_16BIT, data->flash_data, 64, -1);

	 // --- Actualizar contadores progresivos desde flash_data ---
	 struct ContadorMap {
		 int* contador;
		 uint8_t* arreglo_A;
		 int offset;
	 };

	 // Mapear los offsets a los contadores y arreglos
	 ContadorMap mapas[] = {
		 { &data->Total_In_Meter_prg, data->Total_In_Meter_prg_A, 5 },
		 { &data->Total_BET_meter_prg, data->Total_BET_meter_prg_A, 10 },
		 { &data->HopperMeter_prg, data->HopperMeter_prg_A, 15 }
	 };

	 for (auto &map : mapas) {
		 // Reconstruir el valor del contador desde flash_data
		 int valor = 0;
		 for(int pos = 0; pos < 5; pos++) {
			 valor = (valor << 8) | data->flash_data[pos + map.offset];  // Suponiendo que flash_data guarda BCD simple
		 }

		 // Actualizar el contador y el arreglo BCD
		 *(map.contador) = valor;
		 intToBCDArray(*(map.contador), map.arreglo_A);

		 // Guardar el arreglo BCD nuevamente en flash_data (opcional)
		 for(int pos = 0; pos < 5; pos++) {
			 data->flash_data[pos + map.offset] = map.arreglo_A[pos];
		 }
	 }
		   data->Contador_datos_enviados++;

	//	   Serial->Println("Reset de contadores OK corregir JSON");
		   // Preparar datos finales

			datosJson = CrearJsonData(EventoTipo::RamClear , "end" );
			// Enviar JSON final

		   CrearJson_obj->ConstruirJson(datosJson, data->json_progre);
		   Envio_datos_JSON();
		   data->Total_In_Meter = data->Total_In_Meter_prg;
		   data->Total_BET_meter = data->Total_BET_meter_prg;
		   data->HopperMeter = data->HopperMeter_prg;
		   data->Refill = data->Refill_prg;
		   data->HandPayMeter = data->HandPayMeter_prg;
		   data->Evento_Reset = 0;


return State::Estado_Recepcion_Json;
}


